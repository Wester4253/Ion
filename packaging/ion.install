post_install() {
  # The app ships its own icon at every hicolor size; the caches are what make
  # the panel and the app grid see them, and they are only updated when asked.
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
  update-desktop-database -q || true
}

post_upgrade() {
  post_install
}

post_remove() {
  # The user's Ion profile (plugins, settings, themes) lives under
  # ~/.config/Ion and is deliberately untouched: an upgrade or a removal is not
  # a reason to lose it.

  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
  update-desktop-database -q || true
}
