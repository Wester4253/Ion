{
  "name": "ion",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight, Linux-first Discord client mod.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node packages/shell-desktop/assets/generate.mjs --size 1024 --out packages/shell-desktop/build/icon.png",
    "lint": "eslint .",
    "package": "pnpm build && node scripts/collect-bundles.mjs && pnpm --filter @ion/shell-desktop exec electron-builder --config electron-builder.yml",
    "package:arch": "makepkg -C -f -p packaging/PKGBUILD",
    "package:arch:install": "sudo pacman -U packaging/ion-*.pkg.tar.zst",
    "package:linux": "pnpm package -- --linux",
    "package:win": "pnpm package -- --win",
    "prepare": "simple-git-hooks",
    "start": "pnpm --filter @ion/shell-desktop start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "babel-preset-solid": "1.6.16",
      "babel-plugin-jsx-dom-expressions": "0.35.23"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.19.0",
    "babel-preset-solid": "1.6.16",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
