{
  "name": "@ion/compat-bd",
  "version": "0.0.0",
  "private": true,
  "description": "BetterDiscord adapter.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./meta": "./src/manager/meta.ts"
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs",
    "dev": "node ../../scripts/bundle.mjs --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ion/core": "workspace:*"
  },
  "ion": {
    "bundles": [
      {
        "entry": "src/index.ts",
        "outfile": "dist/index.js",
        "platform": "browser",
        "format": "iife"
      }
    ]
  }
}
