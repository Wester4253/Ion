{
  "name": "@ion/compat-shelter",
  "version": "0.0.0",
  "private": true,
  "description": "Shelter adapter: exposes window.shelter and loads plugins from ion/shelter/plugins.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "ion": {
    "bundles": [
      {
        "entry": "src/index.ts",
        "outfile": "dist/index.js",
        "platform": "browser",
        "format": "iife"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs",
    "dev": "node ../../scripts/bundle.mjs --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ion/core": "workspace:*",
    "htm": "^3.1.1",
    "solid-js": "1.6.16",
    "spitroast": "2.2.0"
  }
}
