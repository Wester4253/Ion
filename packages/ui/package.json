{
  "name": "@ion/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Ion in-Discord UI (Preact): settings, plugin manager, browser.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs",
    "dev": "node ../../scripts/bundle.mjs --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ion/core": "workspace:*",
    "preact": "^11.0.1"
  },
  "ion": {
    "bundles": [
      {
        "entry": "src/index.ts",
        "outfile": "dist/index.js",
        "platform": "browser",
        "format": "iife",
        "jsx": "automatic",
        "jsxImportSource": "preact"
      }
    ]
  }
}
